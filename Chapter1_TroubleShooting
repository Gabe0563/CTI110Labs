<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>CTI 110 · Lab 02 — Bug Hunt</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
<style>
  :root{
    --bg: #FAF9F6;
    --ink: #1B1F27;
    --ink-soft: #5B5F6B;
    --accent: #E8A33D;
    --accent-soft: #FCEACB;
    --success: #2F9E44;
    --success-soft: #E6F7EA;
    --danger: #C4453C;
    --danger-soft: #FBE9E7;
    --code-bg: #10141C;
    --code-text: #D8DEE9;
    --border: #E0DCD1;
  }
  *{box-sizing:border-box;}
  body{
    margin:0;
    background:var(--bg);
    color:var(--ink);
    font-family:'Space Grotesk',sans-serif;
    line-height:1.5;
  }
  code, .mono{ font-family:'JetBrains Mono',monospace; }

  header{
    padding:28px 40px 22px;
    border-bottom:2px solid var(--ink);
    display:flex;
    justify-content:space-between;
    align-items:flex-end;
    flex-wrap:wrap;
    gap:12px;
  }
  .eyebrow{
    font-family:'JetBrains Mono',monospace;
    font-size:12px;
    letter-spacing:.08em;
    color:var(--ink-soft);
    text-transform:uppercase;
  }
  h1.title{
    margin:4px 0 0;
    font-size:28px;
    font-weight:700;
  }
  h1.title .tag{
    color:var(--danger);
    font-family:'JetBrains Mono',monospace;
    font-weight:500;
  }
  .course-badge{
    font-family:'JetBrains Mono',monospace;
    font-size:13px;
    background:var(--ink);
    color:var(--bg);
    padding:6px 12px;
    border-radius:3px;
  }

  main{
    display:grid;
    grid-template-columns: 340px 1fr;
    gap:0;
    min-height: calc(100vh - 96px);
  }
  @media (max-width: 900px){
    main{ grid-template-columns: 1fr; }
  }

  .panel-instructions{
    padding:28px 28px 40px;
    border-right:2px solid var(--ink);
  }
  @media (max-width:900px){ .panel-instructions{ border-right:none; border-bottom:2px solid var(--ink); } }

  .panel-instructions h2{
    font-size:15px;
    text-transform:uppercase;
    letter-spacing:.06em;
    margin:0 0 14px;
  }
  .panel-instructions p{ color:var(--ink-soft); font-size:14px; }

  .goal-box{
    background:var(--danger-soft);
    border:1px solid var(--danger);
    border-radius:4px;
    padding:14px 16px;
    font-size:14px;
    margin-bottom:24px;
  }
  .goal-box strong{ display:block; margin-bottom:4px; font-family:'JetBrains Mono',monospace; font-size:12px; text-transform:uppercase; letter-spacing:.05em; color:#8a2f27;}

  .inspector-list{ list-style:none; margin:0; padding:0; }
  .inspector-list li{
    display:flex;
    align-items:flex-start;
    gap:10px;
    padding:12px 0;
    border-bottom:1px solid var(--border);
    font-size:14px;
  }
  .tag-chip{
    font-family:'JetBrains Mono',monospace;
    font-size:12px;
    background:var(--ink);
    color:var(--bg);
    padding:3px 8px;
    border-radius:3px;
    white-space:nowrap;
    margin-top:1px;
  }
  .status-dot{
    width:10px;height:10px;border-radius:50%;
    background:#D8D4C6;
    flex-shrink:0;
    margin-top:5px;
    transition:background .2s ease;
  }
  .inspector-list li.pass .status-dot{ background:var(--success); }
  .inspector-list li.fail .status-dot{ background:var(--danger); }
  .inspector-list li.pass .task-text{ color:var(--ink-soft); text-decoration:line-through; }

  .panel-work{ padding:28px 32px 40px; }
  .work-block{ margin-bottom:22px; }
  .work-label{
    font-family:'JetBrains Mono',monospace;
    font-size:12px;
    text-transform:uppercase;
    letter-spacing:.06em;
    color:var(--ink-soft);
    margin-bottom:8px;
    display:block;
  }
  textarea#editor{
    width:100%;
    min-height:340px;
    background:var(--code-bg);
    color:var(--code-text);
    font-family:'JetBrains Mono',monospace;
    font-size:13.5px;
    line-height:1.6;
    border:none;
    border-radius:6px;
    padding:18px;
    resize:vertical;
    tab-size:2;
    white-space:pre;
  }
  textarea#editor:focus{ outline:2px solid var(--accent); outline-offset:2px; }

  iframe#preview{
    width:100%;
    height:200px;
    border:1px solid var(--border);
    border-radius:6px;
    background:#fff;
  }

  .btn-row{ display:flex; gap:12px; align-items:center; margin-top:18px; flex-wrap:wrap; }
  button#checkBtn{
    font-family:'JetBrains Mono',monospace;
    font-size:14px;
    background:var(--ink);
    color:var(--bg);
    border:none;
    padding:12px 22px;
    border-radius:4px;
    cursor:pointer;
  }
  button#checkBtn:hover{ background:#333; }
  button#checkBtn:focus-visible{ outline:2px solid var(--accent); outline-offset:2px; }

  button#resetBtn{
    font-family:'JetBrains Mono',monospace;
    font-size:13px;
    background:transparent;
    color:var(--ink-soft);
    border:1px solid var(--border);
    padding:11px 16px;
    border-radius:4px;
    cursor:pointer;
  }
  button#resetBtn:hover{ border-color: var(--ink); color:var(--ink); }

  .score-readout{
    font-family:'JetBrains Mono',monospace;
    font-size:14px;
    padding:8px 14px;
    border-radius:4px;
    background:var(--border);
  }
  .score-readout.complete{ background:var(--success-soft); color:var(--success); border:1px solid var(--success); }

  .banner{
    margin-top:18px;
    padding:14px 16px;
    border-radius:5px;
    font-size:14px;
    display:none;
  }
  .banner.show{ display:block; }
  .banner.win{ background:var(--success-soft); border:1px solid var(--success); color:#1e6b30; }

  footer{
    text-align:center;
    font-size:12px;
    color:var(--ink-soft);
    padding:20px;
    font-family:'JetBrains Mono',monospace;
  }
</style>
</head>
<body>

<header>
  <div>
    <div class="eyebrow">CTI 110 &middot; Web Foundations</div>
    <h1 class="title"><span class="tag">&lt;lab n="02"&gt;</span> Bug Hunt</h1>
  </div>
  <div class="course-badge">auto-graded</div>
</header>

<main>
  <section class="panel-instructions">
    <div class="goal-box">
      <strong>Objective</strong>
      The page below has 5 things wrong with it. Find and fix all 5 without changing anything else.
    </div>

    <h2>Instructions</h2>
    <p>The starter code renders, but it isn't correct. Some bugs are visible in the preview, some aren't — you'll need to read the code carefully, not just look at the output.</p>
    <p>Fix the code directly in the editor. Click <strong>Check My Work</strong> to see which bugs remain.</p>

    <h2 style="margin-top:26px;">Bug Tracker</h2>
    <ul class="inspector-list" id="inspectorList">
      <li data-check="title"><span class="status-dot"></span><span class="tag-chip">&lt;title&gt;</span><span class="task-text">A tag name is misspelled — the page has no real title</span></li>
      <li data-check="h1"><span class="status-dot"></span><span class="tag-chip">&lt;h1&gt;</span><span class="task-text">A heading tag is never closed, so it swallows content after it</span></li>
      <li data-check="alt"><span class="status-dot"></span><span class="tag-chip">alt=""</span><span class="task-text">The image is missing an alt attribute</span></li>
      <li data-check="href"><span class="status-dot"></span><span class="tag-chip">href=""</span><span class="task-text">The link's attribute name is misspelled, so it doesn't work</span></li>
      <li data-check="li"><span class="status-dot"></span><span class="tag-chip">&lt;li&gt;</span><span class="task-text">A list item is never closed</span></li>
    </ul>
  </section>

  <section class="panel-work">
    <div class="work-block">
      <label class="work-label" for="editor">Broken HTML — fix it below</label>
      <textarea id="editor" spellcheck="false">&lt;!DOCTYPE html&gt;
&lt;html&gt;
&lt;head&gt;
&lt;titl&gt;My Profile Page&lt;/titl&gt;
&lt;/head&gt;
&lt;body&gt;

&lt;h1&gt;Welcome to My Page

&lt;p&gt;This is a short paragraph about me and what I like to do.&lt;/p&gt;

&lt;img src="https://placekitten.com/300/200"&gt;

&lt;a hef="https://example.com"&gt;Visit Example.com&lt;/a&gt;

&lt;ul&gt;
  &lt;li&gt;Learning HTML
  &lt;li&gt;Learning CSS&lt;/li&gt;
&lt;/ul&gt;

&lt;/body&gt;
&lt;/html&gt;
</textarea>
    </div>

    <div class="work-block">
      <label class="work-label">Live Preview</label>
      <iframe id="preview" title="Live preview of your HTML"></iframe>
    </div>

    <div class="btn-row">
      <button id="checkBtn">Check My Work</button>
      <button id="resetBtn">Reset to Broken Version</button>
      <span class="score-readout" id="scoreReadout">0 / 5 bugs fixed</span>
    </div>

    <div class="banner win" id="winBanner">
      All 5 bugs fixed. The title is correct, the heading closes properly, the image has alt text, the link works, and every list item is closed.
    </div>
  </section>
</main>

<footer>CTI 110 — Lab 02 · Score is calculated locally in your browser</footer>

<script>
  const STARTER = document.getElementById('editor').value;

  const editor = document.getElementById('editor');
  const preview = document.getElementById('preview');
  const checkBtn = document.getElementById('checkBtn');
  const resetBtn = document.getElementById('resetBtn');
  const scoreReadout = document.getElementById('scoreReadout');
  const winBanner = document.getElementById('winBanner');
  const items = document.querySelectorAll('#inspectorList li');

  function renderPreview(html){
    const doc = preview.contentDocument || preview.contentWindow.document;
    doc.open();
    doc.write(html);
    doc.close();
  }

  function gradeHTML(rawHtml){
    const parser = new DOMParser();
    const doc = parser.parseFromString(rawHtml, 'text/html');
    const results = {};

    // 1. <titl> -> <title>
    const titleEl = doc.querySelector('title');
    results.title = !!titleEl && titleEl.textContent.trim().length > 0;

    // 2. unclosed <h1> swallowing the <p>
    const h1 = doc.querySelector('h1');
    const p = doc.querySelector('p');
    results.h1 = !!h1 && !!p && h1.textContent.trim().length > 0
                 && !!p.closest && p.closest('h1') === null
                 && !h1.textContent.includes('short paragraph');

    // 3. missing alt on <img>
    const img = doc.querySelector('img');
    results.alt = !!img && !!img.getAttribute('alt') && img.getAttribute('alt').trim().length > 0;

    // 4. hef= -> href=
    const link = doc.querySelector('a[href]');
    results.href = !!link && link.getAttribute('href').trim().length > 0;

    // 5. unclosed <li> — check raw source since browsers auto-close li visually
    const openCount = (rawHtml.match(/<li[\s>]/gi) || []).length;
    const closeCount = (rawHtml.match(/<\/li\s*>/gi) || []).length;
    results.li = openCount >= 2 && closeCount >= 2 && openCount === closeCount;

    return results;
  }

  function updateUI(results){
    let passed = 0;
    items.forEach(li => {
      const key = li.dataset.check;
      const ok = results[key];
      li.classList.toggle('pass', !!ok);
      li.classList.toggle('fail', !ok);
      if (ok) passed++;
    });

    const total = items.length;
    scoreReadout.textContent = `${passed} / ${total} bugs fixed`;
    scoreReadout.classList.toggle('complete', passed === total);
    winBanner.classList.toggle('show', passed === total);

    // Hook point: this is where a real deployment would POST the score
    // to your LTI backend for Moodle grade passback, e.g.:
    // fetch('/api/grade', { method:'POST', body: JSON.stringify({ lab:'02', passed, total }) });

    return { passed, total };
  }

  function runCheck(){
    const html = editor.value;
    renderPreview(html);
    const results = gradeHTML(html);
    updateUI(results);
  }

  checkBtn.addEventListener('click', runCheck);
  editor.addEventListener('input', () => renderPreview(editor.value));
  resetBtn.addEventListener('click', () => {
    editor.value = STARTER;
    renderPreview(editor.value);
    items.forEach(li => li.classList.remove('pass','fail'));
    scoreReadout.textContent = '0 / 5 bugs fixed';
    scoreReadout.classList.remove('complete');
    winBanner.classList.remove('show');
  });

  renderPreview(editor.value);
</script>

</body>
</html>
